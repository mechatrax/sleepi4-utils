#!/bin/sh

#
# alarm control script for sleepi4
# 

ENV_FILE=/etc/default/sleepi4

if [ -r $ENV_FILE ]
then
    . $ENV_FILE
fi

VERSION="1.0"

GET_USAGE="
  -g, get             get alarm time
"
SET_USAGE="
  -s, set <STRING>    set alarm time described by STRING
"

CLEAR_USAGE="
  -c, clear           clear alarm time
"

USAGE="
Usage: sleepi4alarm [COMMAND]

Commands:
${GET_USAGE}${SET_USAGE}${CLEAR_USAGE}
  -h, help            display help and exit

  -v, version         display version and exit
"

ALARM_PATH="/sys/class/rtc/${RTC_DEVICE}/wakealarm"


#
# calc tz offset
#
calc_offset () {
    if [ -r /etc/adjtime ] &&  grep -q '^LOCAL' /etc/adjtime
    then
        date +%z | awk '{print (substr($0,1,3)*3600) + (substr($0,1,1)substr($0,4,2))*60}'
    else
        echo 0
    fi
}


#
# execute command
#
case $1 in
-g|--get|get)
    if [ ! -e $ALARM_PATH ]
    then
        echo "cannot access $ALARM_PATH" >&2
        exit 1
    fi
    epoch=`cat $ALARM_PATH`
    if [ $epoch ]
    then
        date -d @$(($epoch - $(calc_offset)))
    fi
    ;;
-s|--set|set)
    if [ ! -e $ALARM_PATH ]
    then
        echo "cannot access $ALARM_PATH" >&2
        exit 1
    fi
    if [ "$(cat $ALARM_PATH)" != "" ]
    then
        echo 0 > $ALARM_PATH
    fi
    epoch=`date +%s -d "$2"` && echo $(($epoch + $(calc_offset))) > $ALARM_PATH
    if [ "$(cat $ALARM_PATH)" = "" ]
    then
        echo "error: alarm failure" >&2
        exit 1
    fi
    ;;
-c|--clear|clear)
    if [ ! -e $ALARM_PATH ]
    then
        echo "cannot access $ALARM_PATH" >&2
        exit 1
    fi
    echo 0 > $ALARM_PATH
    ;;
-v|--version|version)
    echo "sleepi4alarm version $VERSION"
    ;;
*)
    echo "$USAGE"
    ;;
esac

if [ $? -ne 0 ]
then
    echo "error: command failure" >&2
    exit 1
fi

